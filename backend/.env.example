# =============================================================================
# ALIGN QMS Backend — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=align_qms
DB_USERNAME=align_user
DB_PASSWORD=change_me_in_production

# ── JWT ──────────────────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 64
# Minimum 32 characters. Must be kept secret — never commit, never log.
# Algorithm: HS512 (symmetric). Upgrade to RS256 if multi-service deployment.
JWT_SECRET=replace_with_minimum_64_character_base64_encoded_secret

# Access token TTL in milliseconds (default: 15 minutes = 900000)
JWT_ACCESS_TOKEN_EXPIRATION=900000

# Refresh token TTL in milliseconds (default: 7 days = 604800000)
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ── Server ───────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Must be exact origins (no wildcards in production with credentials: true).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────
# INFO | DEBUG | WARN | ERROR
LOG_LEVEL=INFO

# ── Spring Profile ───────────────────────────────────────────────────────
# dev | prod | test
SPRING_PROFILES_ACTIVE=dev
