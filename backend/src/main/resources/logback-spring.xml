<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        ALIGN QMS — Logback Configuration
        Uses Spring profile-based conditional appenders.
        NEVER log: passwords, JWT tokens, secrets, sensitive PII.
    -->

    <springProperty scope="context" name="appName"
                    source="spring.application.name"
                    defaultValue="align-qms-backend"/>

    <!-- ── Console Pattern ─────────────────────────────────────────── -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <property name="CONSOLE_PATTERN_COLOR"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n"/>

    <!-- ── Console Appender ────────────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <springProfile name="dev">
                <pattern>${CONSOLE_PATTERN_COLOR}</pattern>
            </springProfile>
            <springProfile name="!dev">
                <pattern>${CONSOLE_PATTERN}</pattern>
            </springProfile>
        </encoder>
    </appender>

    <!-- ── File Appender (prod / non-dev) ─────────────────────────── -->
    <springProfile name="prod">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/align-qms.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/align-qms.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${CONSOLE_PATTERN}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- ── Dev Profile: Verbose Logging ────────────────────────────── -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.align.qms" level="DEBUG"/>
        <logger name="org.flywaydb" level="DEBUG"/>
        <logger name="com.zaxxer.hikari" level="INFO"/>
    </springProfile>

    <!-- ── Non-Dev Profiles: Suppress Noisy Framework Loggers ──────── -->
    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.align.qms" level="INFO"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.springframework.boot.actuate" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>
    </springProfile>

    <!-- ── Prod Profile: Add File Appender ─────────────────────────── -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <logger name="com.align.qms" level="INFO"/>
        <logger name="org.flywaydb" level="INFO"/>
    </springProfile>

</configuration>
